{
  "name": "@healthcare/notification-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Notification worker service consuming BullMQ queue events and sending emails via SMTP for the Healthcare Scheduling System.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "bullmq": "^6.7.2",
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.8",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^6.10.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
