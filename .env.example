# ============================================================
# Healthcare Scheduling System — environment template
# ============================================================
# Copy this file to `.env` before running the stack:
#
#   cp .env.example .env
#
# The values below are safe, local-development defaults. They are
# NOT production secrets. Production deployments must inject
# secrets through Docker secrets or the platform secret manager.
# ============================================================

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
TZ=UTC

# ── PostgreSQL ───────────────────────────────────────────────
# One PostgreSQL instance hosts two isolated databases:
#   auth_db      -> Auth Service
#   schedule_db  -> Schedule Service
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare_dev_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── Auth Service (:3001) ─────────────────────────────────────
AUTH_PORT=3001
AUTH_DATABASE_URL=postgresql://healthcare:healthcare_dev_password@postgres:5432/auth_db?schema=public
# Development-only signing key. Minimum 32 characters enforced at boot.
JWT_SECRET=dev-only-jwt-secret-change-before-any-real-deployment-0123456789
JWT_EXPIRES_IN=1h
JWT_ISSUER=healthcare-auth
JWT_AUDIENCE=healthcare-api
BCRYPT_ROUNDS=12
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5

# ── Schedule Service (:3002) ─────────────────────────────────
SCHEDULE_PORT=3002
SCHEDULE_DATABASE_URL=postgresql://healthcare:healthcare_dev_password@postgres:5432/schedule_db?schema=public
AUTH_SERVICE_URL=http://auth-service:3001/graphql
AUTH_SERVICE_TIMEOUT_MS=2000
AUTH_SERVICE_MAX_RETRIES=1
CACHE_TTL_MS=60000
CACHE_TTL_JITTER_PERCENT=10
CACHE_NEGATIVE_TTL_MS=10000
SCHEDULE_THROTTLE_TTL_MS=60000
SCHEDULE_THROTTLE_LIMIT=100

# ── Redis ────────────────────────────────────────────────────
# Two instances: cache is evictable, queue is durable.
REDIS_CACHE_URL=redis://redis-cache:6379
REDIS_QUEUE_URL=redis://redis-queue:6379
REDIS_PORT=6379

# ── Notification Service (:3003) ─────────────────────────────
NOTIFICATION_PORT=3003
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@healthcare.local
MAIL_FROM_NAME=Healthcare Scheduling
MAIL_TIMEZONE=Asia/Jakarta
BULL_BOARD_ENABLED=true
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin
WORKER_CONCURRENCY=5

# ── Mailpit (local email inspection) ─────────────────────────
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── Demo seed ────────────────────────────────────────────────
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=admin@clinic.local
DEMO_USER_PASSWORD=Password123

# ── Observability ────────────────────────────────────────────
METRICS_ENABLED=true
